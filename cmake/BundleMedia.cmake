# Both static and shared FFmpeg distributions are supported. The small shared
# ffmpeg/ffprobe launchers need all adjacent DLLs to travel with them.
foreach(_required FFMPEG FFPROBE DESTINATION)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${_required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${DESTINATION}")
file(COPY_FILE "${FFMPEG}" "${DESTINATION}/ffmpeg.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${FFPROBE}" "${DESTINATION}/ffprobe.exe" ONLY_IF_DIFFERENT)
get_filename_component(_ffmpeg_dir "${FFMPEG}" DIRECTORY)
get_filename_component(_ffprobe_dir "${FFPROBE}" DIRECTORY)
file(GLOB _runtime_dlls "${_ffmpeg_dir}/*.dll" "${_ffprobe_dir}/*.dll")
list(REMOVE_DUPLICATES _runtime_dlls)
set(_manifest "ffmpeg.exe\nffprobe.exe\n")
foreach(_dll IN LISTS _runtime_dlls)
    file(COPY "${_dll}" DESTINATION "${DESTINATION}")
    get_filename_component(_name "${_dll}" NAME)
    string(APPEND _manifest "${_name}\n")
endforeach()
file(WRITE "${DESTINATION}/media-runtime.txt" "${_manifest}")
