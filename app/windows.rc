#include <windows.h>

// Use the same primary icon resource for both Windows entry points.
1 ICON "assets/easy2gif.ico"

1 VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Easy2GIF\0"
            VALUE "FileVersion", "1.0.1.0\0"
            VALUE "ProductName", "Easy2GIF\0"
            VALUE "ProductVersion", "1.0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
